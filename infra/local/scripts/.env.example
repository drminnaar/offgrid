# postgres pgadmin4 environment variables
OG_PGADMIN_DEFAULT_EMAIL=admin@example.com
OG_PGADMIN_DEFAULT_PASSWORD=password

# keycloak environment variables
OG_KC_BOOTSTRAP_ADMIN_USERNAME=admin
OG_KC_BOOTSTRAP_ADMIN_PASSWORD=admin