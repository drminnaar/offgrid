@client_id={{$dotenv OG_INT_KC_CLIENT_ID}}

# Select the user to authenticate as
@username={{$dotenv OG_INT_KC_PORTAL_ADMIN_USERNAME}}
@password={{$dotenv OG_INT_KC_PORTAL_ADMIN_PASSWORD}}

@realm={{$dotenv OG_INT_KC_REALM}}
@token_url={{$dotenv OG_INT_KC_BASE_URL}}/realms/{{realm}}/protocol/openid-connect/token


###  1. Password Grant (Resource Owner Password Credentials)
# @name login

POST {{token_url}}
Content-Type: application/x-www-form-urlencoded

grant_type=password
&password={{password}}
&username={{username}}
&client_id={{client_id}}


###
@refresh_token={{login.response.body.refresh_token}}


###  2. Refresh Token Grant
POST {{token_url}}
Content-Type: application/x-www-form-urlencoded

grant_type=refresh_token
&client_id={{client_id}}
&refresh_token={{refresh_token}}