{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "ConnectionStrings": {
    "Offgrid": "Server=localhost:5432;User Id=postgres;Password=password;Database=offgrid"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/offgrid-public",
    "Audience": "shop-api",
    "RequireHttpsMetadata": false
  },
  "CorsPolicySettings": {
    "DefaultPolicyName": "AllowShopApp",
    "Policies": [
      {
        "Name": "AllowShopApp",
        "AllowedOrigins": [
          "http://localhost:3000"
        ]
      }
    ]
  }
}