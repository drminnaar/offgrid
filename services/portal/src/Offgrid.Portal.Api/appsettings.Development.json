{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error"
    }
  },
  "ConnectionStrings": {
    "Offgrid": "Server=localhost:5432;User Id=postgres;Password=password;Database=offgrid"
  },
  "KeycloakSettings": {
    "Authority": "http://localhost:8080/realms/offgrid-internal",
    "Audience": "portal-api",
    "RequireHttpsMetadata": false
  },
  "CorsPolicySettings": {
    "DefaultPolicyName": "AllowPortalApp",
    "Policies": [
      {
        "Name": "AllowPortalApp",
        "AllowedOrigins": [
          "http://localhost:4000"
        ]
      }
    ]
  }
}